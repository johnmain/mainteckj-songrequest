# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Public origin of the portal. In production this must be the public URL
# exposed through the Netbird reverse proxy, e.g. https://karaoke.example.com
ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------
# Path to the SQLite database file. In Docker, mount a persistent NAS volume
# at this path so singer data survives container restarts.
DATABASE_URL="local.db"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# 32+ character, high-entropy secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email + password sign-in, for singers without a Google account. With Resend
# configured below, sign-up requires email verification and forgotten passwords
# can be reset by the singer.
AUTH_EMAIL_PASSWORD_ENABLED="false"

# ---------------------------------------------------------------------------
# Transactional email (Resend) — enables self-service password reset
# ---------------------------------------------------------------------------
# https://resend.com/api-keys. When both are set, the login page shows a
# "Forgot password?" link and reset emails are sent from EMAIL_FROM. EMAIL_FROM
# must be an address on a domain you have verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Maintec Karaoke <karaoke@example.org>"

# ---------------------------------------------------------------------------
# Desktop host bridge (Phase 4) — pull model
# ---------------------------------------------------------------------------
# The desktop host polls `POST /api/host/requests/poll` on a timer and reports
# status via `PATCH /api/host/requests/:id`. Both are authenticated with this
# shared secret (the portal never needs to reach the host).
# Generate one with: npm run token:generate   (or: openssl rand -base64 48)
HOST_BRIDGE_TOKEN=""

# ---------------------------------------------------------------------------
# Container deployment (docker compose)
# ---------------------------------------------------------------------------
# Image published by CI to GHCR.
PORTAL_IMAGE="ghcr.io/johnmain/mainteckj-songrequest:latest"
# Host interface the portal's port is published on. Keep 127.0.0.1 if a reverse
# proxy on this host reaches it via localhost (e.g. `netbird expose 3000`). Set
# to 0.0.0.0 for NetBird's dashboard Reverse Proxy with a "Peer" target, which
# connects to the peer's overlay IP (100.x) rather than loopback.
PORTAL_BIND="127.0.0.1"
# Reusable setup key from the NetBird dashboard for the bundled `netbird`
# sidecar. Leave blank only if you run the NetBird client on the host instead
# (and comment the `netbird` service out of docker-compose.yml).
NETBIRD_SETUP_KEY=""

# Max request body size the app accepts (adapter-node). The song-catalog ingest
# is a few MB, far above the 512 KB default, so this is raised.
BODY_SIZE_LIMIT="16M"
# Domain used by the optional Caddy TLS profile (`--profile tls`).
PORTAL_DOMAIN="karaoke.example.org"
