# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Public origin of the portal. In production this must be the public URL
# exposed through the Netbird reverse proxy, e.g. https://karaoke.example.com
ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------
# Path to the SQLite database file. In Docker, mount a persistent NAS volume
# at this path so singer data survives container restarts.
DATABASE_URL="local.db"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# 32+ character, high-entropy secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth — Sign in with Apple
# APPLE_CLIENT_SECRET is a JWT generated from your Apple private key.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Dev-only password sign-in. Set to "true" for local testing without OAuth.
# Never enable this in production.
AUTH_EMAIL_PASSWORD_ENABLED="false"

# ---------------------------------------------------------------------------
# Desktop host bridge (Phase 4) — pull model
# ---------------------------------------------------------------------------
# The desktop host polls `POST /api/host/requests/poll` on a timer and reports
# status via `PATCH /api/host/requests/:id`. Both are authenticated with this
# shared secret (the portal never needs to reach the host).
# Generate one with: npm run token:generate   (or: openssl rand -base64 48)
HOST_BRIDGE_TOKEN=""

# ---------------------------------------------------------------------------
# Container deployment (docker compose)
# ---------------------------------------------------------------------------
# Image published by CI to GHCR — replace <owner> with your GitHub user/org.
PORTAL_IMAGE="ghcr.io/<owner>/mainteckj-songrequest:latest"
# Domain used by the optional Caddy TLS profile (`--profile tls`).
PORTAL_DOMAIN="karaoke.example.org"
